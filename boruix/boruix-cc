#!/bin/sh
# boruix-cc —— 给 GCC 的 Canadian cross 当 $CC 用：用 clang 18 + Boruix sysroot 产出
# **能在 Boruix 内运行**的 ELF（host=boruix 的编译器）。
#
# 为什么需要它：sysroot 自带的 boruix-clang 是一次性驱动（吃 .c 出 .elf），不支持
# configure 需要的 -c/-E/-S 与 -o 组合。
#
# 为什么链接**直接调 ld.lld**（而不是让 clang 驱动）：实测（configure 的第一次尝试）
# clang 对裸机目标 `x86_64-unknown-none` 会**退化成用 gcc 当链接器驱动**，而 MSYS2 的 gcc
# 又找不到 ld —— 报 "collect2: fatal error: cannot find 'ld'"。改为与 sysroot 的
# boruix-clang **同一配方**直接调 ld.lld，既确定又少一层转译。
set -e
# 调试：BORUIX_CC_DEBUG=1 时把本次 argv 原样打到 stderr（排查 configure 探测的真实命令行）。
if [ -n "$BORUIX_CC_DEBUG" ]; then
  echo "boruix-cc argv: $*" >&2
fi
CLANG="F:/clang/18.1.8x86_64/bin/clang.exe"
LLD="F:/clang/18.1.8x86_64/bin/ld.lld.exe"
SYS="$BORUIX_SYSROOT"
common="--target=x86_64-unknown-none -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -O2 -I$SYS/include"
# **C++ 不能带 `-ffreestanding`**（2026-10 实测）：freestanding 模式下 clang 不再把 `main` 当语言特例，
# 会把它修饰成 `_Z4mainv`，于是链接报
#   `undefined symbol: main … did you mean to declare main() as extern "C"?`
# 而 `user_main.o` 要的正是未修饰的 `main`。实测同一文件：带该旗标 → `_Z4mainv`；去掉 → `main`。
# C 侧保持原样（它已长期验证可用），只为 C++ 去掉这一条。
cxx_common="--target=x86_64-unknown-none -fno-builtin -fno-stack-protector -fno-pic -O2 -I$SYS/include"

# 本次调用是否含 C++ 源文件（决定用哪份公共旗标）。
is_cxx=0
for a in "$@"; do
  case "$a" in
    *.cc|*.cpp|*.cxx|*.C|*.CPP) is_cxx=1 ;;
  esac
done

link=1
for a in "$@"; do
  case "$a" in
    -c|-E|-S) link=0 ;;
  esac
done
if [ "$link" = 0 ]; then
  if [ "$is_cxx" = 1 ]; then exec "$CLANG" $cxx_common "$@"; fi
  exec "$CLANG" $common "$@"
fi

# 链接：.c 先编成 .o，再按 sysroot 的配方用 ld.lld 链接。
tmp=$(mktemp -d)
objs=""
cflags=""
libs=""
wl=""
out="a.out"
prev=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then out="$a"; prev=""; continue; fi
  case "$a" in
    -o) prev="-o" ;;
    # **C++ 源文件也要认**（2026-10 实测的根因）：此前只认 *.c，于是 libcody 的 configure
    # 里那条最小 C++ 程序（`int main(){;return 0;}`）**根本没被编译**，链接直接报
    # `ld.lld: error: undefined symbol: main`（引 user_main.o），configure 判「C++ compiler
    # cannot create executables」。语言由扩展名交给 clang 判定，无需额外 -x。
    *.c) o="$tmp/$(basename "$a").o"; "$CLANG" $common $cflags -c "$a" -o "$o"; objs="$objs $o" ;;
    *.cc|*.cpp|*.cxx|*.C|*.CPP) o="$tmp/$(basename "$a").o"; "$CLANG" $cxx_common $cflags -c "$a" -o "$o"; objs="$objs $o" ;;
    *.o|*.a) objs="$objs $a" ;;
    # 外部库与库搜索路径必须透传（第 60 轮实测：MPFR 的 configure 要"链接一次 gmp.h"，
    # 丢了 -l/-L 就会报 "there is an incompatibility between gmp.h and the compiler"——
    # 其实只是没链上 -lgmp）。顺序：对象在前、库在后（符号解析方向）。
    # 编译期影响路径/语义的旗标必须保留：链接分支里若有 .c 要现编，
    # 丢了 -I 就会 "fatal error: gmp.h file not found"（第 60 轮 MPFR 实测）。
    -I*|-D*|-U*|-isystem*|-include*|-std=*) cflags="$cflags $a" ;;
    # GCC 的 C++ 部分固定带 `-fno-exceptions -fno-rtti`（见其编译命令）。**必须透传给编译**：
    # 丢了它们，clang 会按「开异常/开 RTTI」编译，于是拉进 `__gxx_personality_v0`、
    # `__cxa_*` 等 C++ 运行库符号，链接才失败——那时报的是「缺 libstdc++」，而真因是旗标被丢。
    -fno-exceptions|-fno-rtti|-fno-threadsafe-statics) cflags="$cflags $a" ;;
    -l*|-L*) libs="$libs $a" ;;
    # -Wl,a,b -> 直接给 ld.lld 的 a b。
    -Wl,*) wl="$wl $(echo "$a" | sed "s/^-Wl,//; s/,/ /g")" ;;
    *) : ;;
  esac
done
if [ -n "$BORUIX_CC_DEBUG" ]; then
  echo "boruix-cc link: objs=[$objs] libs=[$libs] wl=[$wl]" >&2
fi
"$LLD" -o "$out" -e _start -nostdlib --no-dynamic-linker "$SYS/lib/user_main.o" $objs "$SYS/lib/libc.a" $libs $wl -z noexecstack -z norelro -T "$SYS/lib/linker.ld"
rm -rf "$tmp"
